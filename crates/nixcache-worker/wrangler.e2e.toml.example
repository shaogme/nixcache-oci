name = "nixcache-worker-e2e"
main = "build/worker/shim.mjs"
compatibility_date = "2024-04-03"

[vars]
NIXCACHE_REPO = "YOUR_GITHUB_USERNAME_OR_ORG/YOUR_REPO_NAME"
NIXCACHE_REGISTRY = "ghcr.io"
NIXCACHE_UPSTREAM = "https://cache.nixos.org"
NIXCACHE_INDEX_TTL = "300"
NIXCACHE_BASELINE_TAG = "cache-index-e2e"

[[kv_namespaces]]
binding = "NIXCACHE_KV_E2E"
id = "nixcache_kv_placeholder"

[build]
command = "command -v worker-build >/dev/null 2>&1 || cargo install -q worker-build && worker-build --release"
